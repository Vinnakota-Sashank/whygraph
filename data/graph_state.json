    },
    {
      "key": "Constraint:ADR-001-C1",
      "label": "Constraint",
      "properties": {
        "id": "ADR-001-C1",
        "description": "All services MUST use the shared Redis cluster for caching (no local Memcached, no embedded caches)",
        "type": "OPERATIONAL",
        "severity": "MUST",
        "isActive": true,
        "extractedAt": "2026-03-15",
        "lastValidatedAt": "2026-03-15",
        "source": "ADR"
      }
    },
    {
      "key": "Constraint:ADR-001-C2",
      "label": "Constraint",
      "properties": {
        "id": "ADR-001-C2",
        "description": "Memcached is NOT permitted in any service \u2014 no exceptions without platform team review",
        "type": "ARCHITECTURAL",
        "severity": "MUST",
        "isActive": true,
        "extractedAt": "2026-03-15",
        "lastValidatedAt": "2026-03-15",
        "source": "ADR"
      }
    },
    {
      "key": "Constraint:ADR-001-C3",
      "label": "Constraint",
      "properties": {
        "id": "ADR-001-C3",
        "description": "Cache keys must follow namespace convention: `{service}:{entity}:{id}`",
        "type": "OPERATIONAL",
        "severity": "MUST",
        "isActive": true,
        "extractedAt": "2026-03-15",
        "lastValidatedAt": "2026-03-15",
        "source": "ADR"
      }
    },
    {
      "key": "Constraint:ADR-001-C4",
      "label": "Constraint",
      "properties": {
        "id": "ADR-001-C4",
        "description": "TTL must be explicitly set on all keys (no infinite TTL)",
        "type": "OPERATIONAL",
        "severity": "MUST",
        "isActive": true,
        "extractedAt": "2026-03-15",
        "lastValidatedAt": "2026-03-15",
        "source": "ADR"
      }
    },
    {
      "key": "Constraint:ADR-001-C5",
      "label": "Constraint",
      "properties": {
        "id": "ADR-001-C5",
        "description": "Connection pooling is mandatory (min 5, max 20 connections per service instance)",
        "type": "PERFORMANCE",
        "severity": "MUST",
        "isActive": true,
        "extractedAt": "2026-03-15",
        "lastValidatedAt": "2026-03-15",
        "source": "ADR"
      }
    },
